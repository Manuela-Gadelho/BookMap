<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".BookMapApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookMap"
        tools:targetApi="31">

        <!-- Module A: Auth & Profile -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".PublicProfileActivity" android:exported="false" />

        <!-- Module B: Library & Books -->
        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".BookDetailsActivity" android:exported="false" />
        <activity android:name=".AddBookActivity" android:exported="false" />
        <activity android:name=".SearchActivity" android:exported="false" />
        <activity android:name=".UpdateProgressActivity" android:exported="false" />

        <!-- Module C: Map & Geolocation -->
        <activity android:name=".MapActivity" android:exported="false" />

        <!-- Module D: Clubs & Events -->
        <activity android:name=".ClubActivity" android:exported="false" />
        <activity android:name=".CreateClubActivity" android:exported="false" />
        <activity android:name=".ClubListActivity" android:exported="false" />
        <activity android:name=".EventActivity" android:exported="false" />
        <activity android:name=".ReportActivity" android:exported="false" />

        <!-- Module E: Notifications -->
        <activity android:name=".NotificationsActivity" android:exported="false" />

        <!-- FileProvider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCgRoPHkaL0v3PreuSQZ_A7w_jUVxMLl6Y" />

    </application>

</manifest>
